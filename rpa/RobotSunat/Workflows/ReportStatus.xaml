  <Sequence DisplayName="Informar estado al backend" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="uwahm:HttpResponseSummary" Name="response" />
    </Sequence.Variables>
    <uwah:NetHttpRequest DisplayName="POST estado del trabajo" sap2010:WorkflowViewState.IdRef="NetHttpRequest_1" ContinueOnError="True" Method="POST" RequestBodyType="Text" RequestUrl="[in_JobUrl + &quot;/status&quot;]" Result="[response]" RetryCount="3" RetryPolicyType="Basic" TextPayload="[&quot;{&quot;&quot;status&quot;&quot;:&quot;&quot;&quot; &amp; in_Status &amp; &quot;&quot;&quot;,&quot;&quot;message&quot;&quot;:&quot; &amp; System.Text.Json.JsonSerializer.Serialize(If(in_Message, String.Empty)) &amp; &quot;}&quot;]" TextPayloadContentType="application/json" TextPayloadEncoding="UTF-8" />
    <If DisplayName="¿El backend no aceptó el estado?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="response Is Nothing OrElse CInt(response.StatusCode) &gt;= 300" />
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Avisar en el log" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:LogMessage DisplayName="Log: estado no aceptado" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Warn" Message="[&quot;El backend no aceptó el estado &quot; &amp; in_Status &amp; &quot; (HTTP &quot; &amp; If(response Is Nothing, &quot;?&quot;, CInt(response.StatusCode).ToString()) &amp; &quot;): &quot; &amp; If(response Is Nothing, String.Empty, response.TextContent)]" />
        </Sequence>
      </If.Then>
    </If>
  </Sequence>
