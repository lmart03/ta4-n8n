# Panel del bot: ADMIN_KEY es la clave que se escribe en la web; BOT_INGEST_KEY la usa n8n para avisar al backend.
# Usa frases largas y distintas entre si. Sin ADMIN_KEY el panel queda cerrado.
ADMIN_KEY=
BOT_INGEST_KEY=
