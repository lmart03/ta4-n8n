RUC_UPLOAD_KEY=
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/
TELEGRAM_BOT_TOKEN=pendiente
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=pendiente
