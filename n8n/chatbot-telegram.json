    {
      "parameters": {
        "jsCode": "const m=$input.first().json.body?.message;const chatId=m?.chat?.id;if(chatId===undefined||chatId===null)return [];const raw=typeof m?.text==='string'?m.text.trim():'';const name=[m?.from?.first_name,m?.from?.last_name].filter(Boolean).join(' ')||undefined;return [{json:{chatId,name,username:m?.from?.username,text:raw.slice(0,500),valid:raw.length>0&&raw.length<=500,start:/^\\/start(@\\w+)?(\\s|$)/i.test(raw),startedAt:Date.now()}}];"
      },
