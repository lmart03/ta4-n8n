        "jsCode": "const c=$('Preparar contexto Gemini').first().json;const d=$input.first().json;const s=d.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('').trim();return [{json:{chatId:c.chatId,reply:s||c.fallback,source:s?'IA':'CONTINGENCIA',startedAt:c.startedAt}}];"
