    },
    {
      "parameters": {
        "jsCode": "const s=$input.first().json;const reply=s.start?'¡Hola! Soy el asistente informativo de la Clínica Soraka. Puedo orientarte sobre medicina general, pediatría, ginecología, dermatología y laboratorio clínico, además de horarios, ubicación, precios y cómo solicitar una cita. ¿Qué necesitas saber?':'Envíame una pregunta de texto de hasta 500 caracteres sobre horarios, ubicación, servicios, precios o citas de la Clínica Soraka.';return [{json:{chatId:s.chatId,reply,source:'AYUDA',startedAt:s.startedAt}}];"
      },
      "id": "help",
      "name": "Ayuda para mensaje no textual",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8080/api/v1/faqs/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.text }}"
            }
          ]
        },
        "options": {
          "timeout": 7000
        }
      },
      "id": "search",
      "name": "API | Buscar FAQ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        100
      ],
      "onError": "continueRegularOutput",
      "notes": "Ante error, continúa hacia un mensaje de contingencia."
    },
    {
      "parameters": {
        "jsCode": "const source=$('Normalizar mensaje').first().json;const d=$input.first().json;const matches=Array.isArray(d.matches)?d.matches:[];const risky=/diagn[oó]stic|recet|medicin|medicament|tratamiento|dosis|pastilla|qu[eé] (tengo|tomo|me tomo)|s[ií]ntoma|historia cl[ií]nica|resultados? de|paciente [a-z]/i.test(source.text);const base={chatId:source.chatId,question:source.text,startedAt:source.startedAt};if(risky)return [{json:{...base,matches:[],needsAi:false,source:'RECHAZO',reply:'No puedo dar diagnósticos, indicar tratamientos ni compartir datos de pacientes. Solicita una cita con recepción para que un profesional te atienda.'}}];let reply='';let src='FAQ';if(d.error||!Array.isArray(d.matches)){reply='Ahora no puedo consultar la información de la clínica. Intenta de nuevo más tarde.';src='CONTINGENCIA';}else if(!matches.length){reply='Solo puedo responder consultas sobre la Clínica Soraka con información registrada. No dispongo de ese dato; consulta a recepción.';src='DERIVADA';}else if(matches.length===1)reply=matches[0].answer;return [{json:{...base,matches,needsAi:matches.length>1,reply,source:src}}];"
      },
      "id": "decide",
      "name": "Decidir FAQ o contingencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
